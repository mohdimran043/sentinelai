node_modules/
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.local
dist/
build/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
datasets/**
!datasets/*.sh
!datasets/*.md
!datasets/.gitkeep
# A validation dataset gets a directory with its own fetcher and provenance note. The
# media it downloads stays ignored by the rule above — it is somebody else's data, and
# git is not where a video dataset belongs.
!datasets/*/
!datasets/*/*.sh
!datasets/*/*.md
models/
*.engine
*.onnx
*.pt
*.safetensors
recordings/
clips/
.DS_Store
ai-engine/.venv/
ai-engine/var/
# The operator's real camera list (URLs, credentials in the URL, site names).
# `ai-engine/cameras.example.json` is the committed template.
ai-engine/cameras.json
# `CameraFileStore._write`'s write-then-rename temp file (also covers a camera
# file at a `SENTINEL_CAMERAS_FILE` override path other than the default above).
# It briefly holds a full copy of the document above, credentials included, and a
# rename that fails partway can leave it behind — it needs the same protection.
*.json.tmp
__pycache__/
.pytest_cache/
